// Deployed by the afd-upload workflow: upload.cptdaz.org, mTLS enforced, private storage via Private Link, client sends a user delegation SAS.
param profileName string
param endpointName string
param hostName string
param uploadStorageName string
@description('Name of the Front Door secret (mTLS CA chain) owned by the base workflow')
param mtlsSecretName string = 'mtls-ca'
param location string = resourceGroup().location

var domainName = replace(hostName, '.', '-')
var storageHost = '${uploadStorageName}.blob.${environment().suffixes.storage}'

resource profile 'Microsoft.Cdn/profiles@2026-07-01' existing = {
  name: profileName
}

resource mtlsSecret 'Microsoft.Cdn/profiles/secrets@2026-07-01' existing = {
  parent: profile
  name: mtlsSecretName
}

resource endpoint 'Microsoft.Cdn/profiles/afdEndpoints@2026-07-01' = {
  parent: profile
  name: endpointName
  location: 'global'
  properties: {
    enabledState: 'Enabled'
    autoGeneratedDomainNameLabelScope: 'SubscriptionReuse'
    enforceMtls: 'Enabled'
  }
}

resource domain 'Microsoft.Cdn/profiles/customDomains@2026-07-01' = {
  parent: profile
  name: domainName
  properties: {
    hostName: hostName
    tlsSettings: {
      certificateType: 'ManagedCertificate'
      minimumTlsVersion: 'TLS12'
    }
    mtlsSettings: {
      scenario: 'ClientCertificateRequiredAndValidated'
      secrets: [ { id: mtlsSecret.id } ]
      certificateRevocationCheck: 'Disabled'
    }
  }
}

resource og 'Microsoft.Cdn/profiles/originGroups@2026-07-01' = {
  parent: profile
  name: 'og-upload-storage'
  properties: {
    loadBalancingSettings: {
      sampleSize: 4
      successfulSamplesRequired: 3
      additionalLatencyInMilliseconds: 50
    }
    sessionAffinityState: 'Disabled'
  }
}

resource origin 'Microsoft.Cdn/profiles/originGroups/origins@2026-07-01' = {
  parent: og
  name: 'storage'
  properties: {
    hostName: storageHost
    originHostHeader: storageHost
    httpPort: 80
    httpsPort: 443
    priority: 1
    weight: 1000
    enabledState: 'Enabled'
    enforceCertificateNameCheck: true
    sharedPrivateLinkResource: {
      privateLink: { id: resourceId('Microsoft.Storage/storageAccounts', uploadStorageName) }
      groupId: 'blob'
      privateLinkLocation: location
      requestMessage: 'afd-upload storage'
    }
  }
}

resource route 'Microsoft.Cdn/profiles/afdEndpoints/routes@2026-07-01' = {
  parent: endpoint
  name: 'route-upload'
  properties: {
    customDomains: [ { id: domain.id } ]
    originGroup: { id: og.id }
    supportedProtocols: [ 'Https' ]
    patternsToMatch: [ '/upload/*' ]
    forwardingProtocol: 'HttpsOnly'
    linkToDefaultDomain: 'Disabled'
    httpsRedirect: 'Disabled'
    enabledState: 'Enabled'
  }
  dependsOn: [ origin ]
}

output endpointHostName string = endpoint.properties.hostName
output domainName string = domain.name
output validationToken string = domain.properties.validationProperties.validationToken
output privateLinkResourceIds array = [
  resourceId('Microsoft.Storage/storageAccounts', uploadStorageName)
]
