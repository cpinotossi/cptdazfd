// Deployed by the afd-hello workflow. Adds endpoint, domain, origins and routes for hello.cptdaz.org to the public profile.
param profileName string
param endpointName string
param hostName string
param helloStorageName string
param plsId string
param vmOriginHost string
param location string = resourceGroup().location

var domainName = replace(hostName, '.', '-')

resource profile 'Microsoft.Cdn/profiles@2026-07-01' existing = {
  name: profileName
}

resource endpoint 'Microsoft.Cdn/profiles/afdEndpoints@2026-07-01' = {
  parent: profile
  name: endpointName
  location: 'global'
  properties: {
    enabledState: 'Enabled'
    autoGeneratedDomainNameLabelScope: 'SubscriptionReuse'
  }
}

resource domain 'Microsoft.Cdn/profiles/customDomains@2026-07-01' = {
  parent: profile
  name: domainName
  properties: {
    hostName: hostName
    tlsSettings: {
      certificateType: 'ManagedCertificate'
      minimumTlsVersion: 'TLS12'
    }
  }
}

// ---- hello.txt from the private storage account (Private Link)
resource ogStorage 'Microsoft.Cdn/profiles/originGroups@2026-07-01' = {
  parent: profile
  name: 'og-hello-storage'
  properties: {
    loadBalancingSettings: {
      sampleSize: 4
      successfulSamplesRequired: 3
      additionalLatencyInMilliseconds: 50
    }
    healthProbeSettings: {
      probePath: '/hello.txt'
      probeRequestType: 'HEAD'
      probeProtocol: 'Https'
      probeIntervalInSeconds: 100
    }
    sessionAffinityState: 'Disabled'
  }
}

var storageHost = '${helloStorageName}.blob.${environment().suffixes.storage}'

resource originStorage 'Microsoft.Cdn/profiles/originGroups/origins@2026-07-01' = {
  parent: ogStorage
  name: 'storage'
  properties: {
    hostName: storageHost
    originHostHeader: storageHost
    httpPort: 80
    httpsPort: 443
    priority: 1
    weight: 1000
    enabledState: 'Enabled'
    enforceCertificateNameCheck: true
    sharedPrivateLinkResource: {
      privateLink: { id: resourceId('Microsoft.Storage/storageAccounts', helloStorageName) }
      groupId: 'blob'
      privateLinkLocation: location
      requestMessage: 'afd-hello storage'
    }
  }
}

// ---- index.html from the VM (Private Link Service behind an internal load balancer)
resource ogVm 'Microsoft.Cdn/profiles/originGroups@2026-07-01' = {
  parent: profile
  name: 'og-hello-vm'
  properties: {
    loadBalancingSettings: {
      sampleSize: 4
      successfulSamplesRequired: 3
      additionalLatencyInMilliseconds: 50
    }
    healthProbeSettings: {
      probePath: '/health'
      probeRequestType: 'GET'
      probeProtocol: 'Http'
      probeIntervalInSeconds: 60
    }
    sessionAffinityState: 'Disabled'
  }
}

resource originVm 'Microsoft.Cdn/profiles/originGroups/origins@2026-07-01' = {
  parent: ogVm
  name: 'vm'
  properties: {
    hostName: vmOriginHost
    originHostHeader: hostName
    httpPort: 80
    httpsPort: 443
    priority: 1
    weight: 1000
    enabledState: 'Enabled'
    enforceCertificateNameCheck: true
    sharedPrivateLinkResource: {
      privateLink: { id: plsId }
      privateLinkLocation: location
      requestMessage: 'afd-hello vm'
    }
  }
}

resource routeTxt 'Microsoft.Cdn/profiles/afdEndpoints/routes@2026-07-01' = {
  parent: endpoint
  name: 'route-hello-txt'
  properties: {
    customDomains: [ { id: domain.id } ]
    originGroup: { id: ogStorage.id }
    supportedProtocols: [ 'Http', 'Https' ]
    patternsToMatch: [ '/hello.txt' ]
    forwardingProtocol: 'HttpsOnly'
    linkToDefaultDomain: 'Disabled'
    httpsRedirect: 'Enabled'
    enabledState: 'Enabled'
  }
  dependsOn: [ originStorage ]
}

resource routeHtml 'Microsoft.Cdn/profiles/afdEndpoints/routes@2026-07-01' = {
  parent: endpoint
  name: 'route-hello-html'
  properties: {
    customDomains: [ { id: domain.id } ]
    originGroup: { id: ogVm.id }
    supportedProtocols: [ 'Http', 'Https' ]
    patternsToMatch: [ '/', '/index.html' ]
    forwardingProtocol: 'HttpOnly'
    linkToDefaultDomain: 'Disabled'
    httpsRedirect: 'Enabled'
    enabledState: 'Enabled'
  }
  dependsOn: [ originVm, routeTxt ]
}

output endpointHostName string = endpoint.properties.hostName
output domainName string = domain.name
output validationToken string = domain.properties.validationProperties.validationToken
output privateLinkResourceIds array = [
  resourceId('Microsoft.Storage/storageAccounts', helloStorageName)
  plsId
]
